{
  "name": "@agrodt/gitlab-cicq",
  "version": "1.1.0",
  "description": "Run ESLint and TypeScript in GitLab CI pipelines and generate a single code quality report.",
  "keywords": [
    "ci",
    "code-quality",
    "codeclimate",
    "eslint",
    "gitlab",
    "typescript"
  ],
  "homepage": "https://github.com/AgroDT/gitlab-cicq",
  "bugs": {
    "url": "https://github.com/AgroDT/gitlab-cicq/issues"
  },
  "license": "MIT",
  "author": "Petr Tsymbarovich <petr@tsymbarovich.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgroDT/gitlab-cicq.git"
  },
  "bin": {
    "gitlab-cicq": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "prepare": "tsc"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "codeclimate-types": "^0.3.1",
    "eslint": "^9.39.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.38.0",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
