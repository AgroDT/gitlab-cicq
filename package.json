{
  "name": "@agrodt/gitlab-cicq",
  "version": "2.0.1",
  "description": "Run ESLint, TypeScript, Oxlint, Oxfmt, and Biome in GitLab CI pipelines and generate a single code quality report.",
  "keywords": [
    "biome",
    "ci",
    "code-quality",
    "codeclimate",
    "eslint",
    "gitlab",
    "oxfmt",
    "oxlint",
    "typescript"
  ],
  "homepage": "https://github.com/AgroDT/gitlab-cicq",
  "bugs": {
    "url": "https://github.com/AgroDT/gitlab-cicq/issues"
  },
  "license": "MIT",
  "author": "Petr Tsymbarovich <petr@tsymbarovich.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgroDT/gitlab-cicq.git"
  },
  "bin": {
    "gitlab-cicq": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "prepare": "tsc"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "codeclimate-types": "^0.3.1",
    "eslint": "^10.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@biomejs/biome": "*",
    "eslint": "*",
    "oxfmt": "*",
    "oxlint": "*",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
